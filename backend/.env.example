# ---------------------------------------------------------------- server
PORT=4000
# development | production (production enables config warnings and strict CORS)
NODE_ENV=development
# Where the frontend is served from (used to redirect back after Google OAuth).
# Local: http://localhost:3000   Single-service deploy: same as the backend URL.
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed browser origins. Leave empty locally (localhost is allowed).
CORS_ORIGINS=
# Set to 1 when running behind a proxy/load balancer (Render, Railway, Heroku) so rate limits see real IPs.
TRUST_PROXY=
# true = the backend also serves the frontend files (one service, no CORS needed).
SERVE_FRONTEND=false

# ---------------------------------------------------------------- storage
# Empty = local JSON files in backend/data (development only; NOT durable on cloud hosts).
MONGODB_URI=
# If Atlas fails with "querySrv ECONNREFUSED", set public DNS servers for the SRV lookup:
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# ---------------------------------------------------------------- ML service
ML_SERVICE_URL=http://127.0.0.1:8000
ML_TIMEOUT_MS=10000

# ---------------------------------------------------------------- Gmail API / Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/gmail/callback
# Encrypts stored Gmail tokens (AES-256-GCM). Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later makes existing stored tokens unreadable (users must reconnect Gmail).
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------- sending limits
# Pause between emails (ms). Gmail allows roughly 500 recipients/day on personal accounts.
SEND_DELAY_MS=1200
GMAIL_DAILY_LIMIT=400

# ---------------------------------------------------------------- misc
SESSION_DAYS=7
RATE_LIMIT_PER_MIN=300
